cabal-version: 3.0
name:          encoins-relay-delegation
version:       0.1.0.0
author:
  Grigory Petrov
  Vladimir Sinyakov

maintainer:    team@encoins.io
build-type:    Custom

custom-setup
  setup-depends:
    , base       >=4.9
    , Cabal      >=3.2
    , directory  >=1.3 && <1.4

-- Plutus language settings
common lang
  default-language: Haskell2010
  ghc-options:
    -fwarn-redundant-constraints -Wall -Widentities
    -Wincomplete-uni-patterns -Wincomplete-record-updates
    -Wnoncanonical-monad-instances -Wredundant-constraints
    -Wno-unused-do-bind -Wall -fno-ignore-interface-pragmas
    -fno-omit-interface-pragmas -fno-specialise -fno-strictness
    -fobject-code -fplugin-opt PlutusTx.Plugin:defer-errors

-- See Plutus Tx readme
library
  import:          lang
  hs-source-dirs:  src
  other-modules:   Paths_encoins_relay_delegation
  exposed-modules:
    Encoins.Relay.Delegation.Client
    Encoins.Relay.Delegation.Internal
    Encoins.Relay.Delegation.Server

  build-depends:
    , aeson
    , aeson-casing
    , async
    , base                      >=4.9 && <5
    , bytestring
    , cardano-api
    , containers
    , directory
    , encoins-common-constant
    , encoins-common-log
    , encoins-common-transform
    , encoins-common-version
    , encoins-relay-common
    , exceptions
    , extra
    , file-embed
    , gitrev
    , katip
    , mtl
    , network-uri
    , plutus-apps-extra
    , plutus-ledger
    , plutus-ledger-api
    , plutus-tx
    , process
    , say
    , servant
    , servant-client
    , servant-server
    , terminal-progress-bar
    , text
    , time
    , transformers

executable encoins-relay-delegation
  default-language: Haskell2010
  hs-source-dirs:   app_deleg
  main-is:          Main.hs
  build-depends:
    , base                >=4.9 && <5
    , encoins-relay-delegation

executable encoins-relay-delegation-client
  default-language: Haskell2010
  hs-source-dirs:   app_deleg_client
  main-is:          Main.hs
  build-depends:
    , base                >=4.9 && <5
    , encoins-relay-delegation