cabal-version: 3.0
name:          encoins-relay-poll
version:       0.1.0.0
author:
  Grigory Petrov
  Vladimir Sinyakov

maintainer:    team@encoins.io
build-type:    Custom

custom-setup
  setup-depends:
    , base       >=4.9
    , Cabal      >=3.2 && <3.3
    , directory  >=1.3 && <1.4

-- Plutus language settings
common lang
  default-language: Haskell2010
  ghc-options:
    -fwarn-redundant-constraints -Wall -Widentities
    -Wincomplete-uni-patterns -Wincomplete-record-updates
    -Wnoncanonical-monad-instances -Wredundant-constraints
    -Wno-unused-do-bind -Wall -fno-ignore-interface-pragmas
    -fno-omit-interface-pragmas -fno-specialise -fno-strictness
    -fobject-code -fplugin-opt PlutusTx.Plugin:defer-errors

-- See Plutus Tx readme
library
  import:          lang
  hs-source-dirs:  src
  other-modules:   Paths_encoins_relay_poll
  exposed-modules:
    Encoins.Relay.Poll.Config
    Encoins.Relay.Poll.Main

  build-depends:
    , aeson
    , base                      >=4.9 && <5
    , cardano-api
    , cardano-node-emulator
    , cardano-server
    , encoins-relay-common
    , extra
    , lens
    , lens-aeson
    , mtl
    , plutus-apps-extra
    , plutus-ledger
    , plutus-ledger-api
    , plutus-tx
    , terminal-progress-bar
    , text
    , transformers

executable encoins-relay-poll
  default-language: Haskell2010
  hs-source-dirs:   app_poll
  main-is:          Main.hs
  build-depends:
    , base                >=4.9 && <5
    , encoins-relay-poll