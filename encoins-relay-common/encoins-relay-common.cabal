cabal-version: 3.0
name:          encoins-relay-common
version:       0.1.0.0
author:
  Grigory Petrov
  Vladimir Sinyakov

maintainer:    team@encoins.io
build-type:    Custom

custom-setup
  setup-depends:
    , base       >=4.9
    , Cabal      >=3.2 && <3.3
    , directory  >=1.3 && <1.4

-- Plutus language settings
common lang
  default-language: Haskell2010
  ghc-options:
    -fwarn-redundant-constraints -Wall -Widentities
    -Wincomplete-uni-patterns -Wincomplete-record-updates
    -Wnoncanonical-monad-instances -Wredundant-constraints
    -Wno-unused-do-bind -Wall -fno-ignore-interface-pragmas
    -fno-omit-interface-pragmas -fno-specialise -fno-strictness
    -fobject-code -fplugin-opt PlutusTx.Plugin:defer-errors

-- See Plutus Tx readme
library
  import:          lang
  hs-source-dirs:  src
  exposed-modules:
    Encoins.Relay.Common
    Encoins.Relay.Common.Error
    Encoins.Relay.Common.Error.Class
    Encoins.Relay.Common.Error.Envelope
    Encoins.Relay.Common.Error.Utils
    Encoins.Relay.Common.Server
    Encoins.Relay.Common.Server.Endpoint.Ping
    Encoins.Relay.Common.Server.Endpoint.Version
    Encoins.Relay.Common.Server.Handler
    Encoins.Relay.Common.Tx
    Encoins.Relay.Common.Tx.Input
    Encoins.Relay.Common.Wallet

  build-depends:
    , aeson
    , base                      >=4.9 && <5
    , cardano-addresses
    , cryptonite
    , bytestring
    , cardano-api
    , cardano-node-emulator
    , containers
    , data-default
    , directory
    , encoins-common-constant
    , encoins-common-log
    , encoins-common-transform
    , encoins-common-version
    , exceptions
    , extra
    , filepath
    , hex-text
    , http-client
    , http-client-tls
    , http-types
    , katip
    , memory
    , mtl
    , lens
    , lens-aeson
    , plutus-apps-extra
    , plutus-ledger
    , plutus-ledger-api
    , plutus-script-utils
    , plutus-tx
    , plutus-tx-constraints
    , prettyprinter
    , servant
    , servant-server
    , servant-client
    , servant-client-core
    , terminal-progress-bar
    , text
    , text-class
    , time
    , wai
    , wai-cors
    , warp
    , world-peace