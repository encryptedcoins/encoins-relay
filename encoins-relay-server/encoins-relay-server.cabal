cabal-version:      3.0

name:               encoins-relay-server
version:            1.2.6.0

author:             Grigory Petrov
                    Vladimir Sinyakov
maintainer:         team@encoins.io
build-type:         Custom

custom-setup
    setup-depends: base >= 4.9,
                   Cabal == 3.2.*,
                   directory == 1.3.*

-- Plutus language settings
common lang
    default-language:   Haskell2010
    ghc-options:
      -fwarn-redundant-constraints
      -Wall
      -Widentities
      -Wincomplete-uni-patterns
      -Wincomplete-record-updates
      -Wnoncanonical-monad-instances
      -Wredundant-constraints
      -Wno-unused-do-bind

      -- See Plutus Tx readme
      -fno-ignore-interface-pragmas
      -fno-omit-interface-pragmas
      -fno-specialise
      -fno-strictness
      -fobject-code
      -fplugin-opt PlutusTx.Plugin:defer-errors

library
    import: lang
    hs-source-dirs: src
    other-modules: Paths_encoins_relay_server
    exposed-modules:
      Encoins.Relay.Server.Api
      Encoins.Relay.Server.Config
      Encoins.Relay.Server.Delegation
      Encoins.Relay.Server.Endpoint.NewTx
      Encoins.Relay.Server.Endpoint.ServerTx
      Encoins.Relay.Server.Endpoint.Status
      Encoins.Relay.Server.Endpoint.SubmitTx
      Encoins.Relay.Server.Endpoint.Utxos
      Encoins.Relay.Server.Internal
      Encoins.Relay.Server.Main
      Encoins.Relay.Server.Opts
      Encoins.Relay.Server.Server
    build-depends:
      , base                          >= 4.9 && < 5
      , aeson-casing
      , aeson
      , bytestring
      , cardano-addresses
      , cardano-api
      , cardano-node-emulator
      , cardano-server
      , cardano-server-client
      , containers
      , csl-types
      , data-default
      , directory
      , encoins-bulletproofs
      , encoins-common-constant
      , encoins-common-log
      , encoins-common-transform
      , encoins-common-version
      , encoins-core
      , encoins-relay-common
      , encoins-relay-delegation
      , encoins-relay-verifier
      , exceptions
      , extra
      , file-embed
      , gitrev
      , hex-text
      , katip
      , lens
      , lens-aeson
      , mtl
      , optparse-applicative
      , plutus-apps-extra
      , plutus-tx
      , plutus-tx-constraints
      , plutus-ledger
      , plutus-ledger-api
      , plutus-script-utils
      , random
      , servant-server
      , servant-client
      , say
      , text
      , time

executable encoins-relay-server
  default-language: Haskell2010
  hs-source-dirs: app
  main-is: Main.hs
  build-depends:
    base                          >= 4.9 && < 5,
    encoins-relay-server                       ,